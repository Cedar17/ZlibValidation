  Node1 [label="slang::syntax::SyntaxListBase",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="A base class for syntax nodes that represent a list of items."];
  Node2 -> Node1 [dir="back",color="steelblue1",style="solid"];
  Node2 [label="slang::syntax::SyntaxNode",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classslang_1_1syntax_1_1SyntaxNode.html",tooltip="Base class for all syntax nodes."];
  Node1 -> Node3 [dir="back",color="steelblue1",style="solid"];
  Node3 [label="slang::syntax::Separated\lSyntaxList\< T \>",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classslang_1_1syntax_1_1SeparatedSyntaxList.html",tooltip=" "];
  Node1 -> Node4 [dir="back",color="steelblue1",style="solid"];
